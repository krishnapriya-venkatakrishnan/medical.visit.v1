# Copy to .env.local (or .env) and fill in. Never commit a file with a real key.
# Server-side only - these are never exposed to the client.

# Optional. Without it the app runs on the built-in sample / template pre-briefs
# and debriefs (labelled "sample" in the UI).
ANTHROPIC_API_KEY=

# Only needed if ANTHROPIC_API_KEY is an identity-linked key (the API then
# requires the workspace to be named on every request).
ANTHROPIC_WORKSPACE_ID=
